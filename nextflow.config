/*
 * -------------------------------------------------
 *  alternative-splicing-nextflow Nextflow config
 * -------------------------------------------------
 */

manifest {
    name            = 'alternative-splicing-nextflow'
    author          = 'BCI-KRP'
    homePage        = 'https://github.com/damouzo/alternative-splicing-nextflow'
    description     = 'Multi-tool differential alternative splicing analysis pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '1.2.0'
}

// Global default params
params {
    // Input/output
    input        = null
    comparisons  = null
    outdir       = './results'
    
    // Reference files (must match what was used in the upstream nf-core/rnaseq run)
    gtf              = null
    genome_fasta     = null   // required when use_gffread = true
    transcript_fasta = null   // optional when use_gffread = true
    use_gffread      = false  // derive transcript FASTA from genome_fasta + gtf via gffread
    genome_build     = 'hg38' // for MAJIQ config
    
    // Library properties (from the nf-core/rnaseq run)
    strandedness = null     // 'unstranded', 'forward', or 'reverse'
    read_length  = null     // read length after trimming
    is_gencode   = false
    
    // Tool switches
    run_rmats      = true
    run_majiq      = true
    run_isar       = true
    run_leafcutter = false
    
    // rMATS defaults
    rmats_cstat               = 0.0001
    rmats_min_intron_length   = 50
    rmats_max_exon_length     = 500
    rmats_tstat_threads       = 6
    rmats_read_type           = 'paired'  // 'paired' or 'single'
    // Detect unannotated (de novo) splice sites. Relevant for spliceosome
    // mutants (DDX41/DHX34). Increases runtime ~3-5x. MAJIQ covers de novo
    // natively; rMATS adds a second statistical method (binomial/LRT).
    rmats_novel_ss            = true
    
    // MAJIQ (licence file required — obtain from majiq.biociphers.org)
    majiq_license             = System.getenv('MAJIQ_LICENSE_FILE') ?: null  // path to majiq_license*.key file
    majiq_sif                 = System.getenv('MAJIQ_SIF') ?: null            // path to majiq Apptainer .sif OR Docker image tag

    // Container overrides — default to GHCR images built and published by build-containers.yml.
    // Override via env var or --isar_container / --report_container / --sashimi_container / --pegasas_container flags.
    isar_container            = System.getenv('ISAR_CONTAINER')    ?: null   // default: ghcr.io/damouzo/alternative-splicing-nextflow/isar:latest
    report_container          = System.getenv('REPORT_CONTAINER')  ?: null   // default: ghcr.io/damouzo/alternative-splicing-nextflow/report:latest
    sashimi_container         = System.getenv('SASHIMI_CONTAINER') ?: null   // default: ghcr.io/damouzo/alternative-splicing-nextflow/sashimi:latest
    pegasas_container         = System.getenv('PEGASAS_CONTAINER') ?: null   // default: ghcr.io/damouzo/alternative-splicing-nextflow/pegasas:latest
    leafcutter_container      = System.getenv('LEAFCUTTER_CONTAINER') ?: null  // default: ghcr.io/damouzo/alternative-splicing-nextflow/leafcutter:latest
    majiq_min_denovo_reads    = 2
    majiq_min_intronic_cov    = 3
    majiq_min_reads           = 10
    majiq_min_nonzero         = 3
    majiq_delta_psi_threshold = 0.2
    majiq_probability_threshold = 0.95
    
    // ISAR defaults
    isar_alpha            = 0.05
    isar_dif_cutoff       = 0.1
    isar_gene_expr_cutoff = 1
    isar_iso_expr_cutoff  = 1     // min TPM per isoform; 0 retains unexpressed isoforms
    // Switch-test engine, selected per contrast. 'auto' reproduces ISAR's own
    // adequacy rule: when the smallest condition has <= 5 replicates DEXSeq
    // (LRT, negative binomial) is used, otherwise satuRn. DEXSeq avoids the
    // locfdr empirical-FDR step in satuRn that can pin every q-value to one
    // value in high-isoform runs. Override with 'dexseq' or 'satuRn'.
    isar_test_method      = 'auto'

    // ISAR full functional annotation — Tier A (PFAM + IUPred3)
    // Gate with --run_isar_full_annotation true; also provide --pfam_hmm
    run_isar_full_annotation = false        // enable PFAM + IUPred3 annotation steps
    pfam_hmm                 = null         // path to user-provided Pfam-A.hmm database
    
    // Report defaults
    report_fdr_cutoff  = 0.05
    report_dpsi_cutoff = 0.1

    // Organism for GO/KEGG enrichment (clusterProfiler); supported: 'human', 'mouse'
    organism = 'human'

    // Sashimi plots (rmats2sashimiplot) — optional, disabled by default
    run_sashimi          = false
    sashimi_top_n        = 30     // events per event type to plot
    sashimi_group1_label = 'group1'
    sashimi_group2_label = 'group2'
    sashimi_exon_scale   = 1
    // Minimum junction reads (IJC+SJC) per group for the report ranking tables
    // only — significance calling is never filtered by coverage.
    report_min_reads     = 20
    sashimi_intron_scale = 5
    sashimi_png_dpi      = 150    // resolution of the PNGs embedded in the HTML report

    // PEGASAS: pathway activity × splicing PSI correlation — optional
    run_pegasas           = false
    pathway_gmt           = null   // GMT gene signature file. Falls back to built-in hallmarks50 if not set.
    salmon_merged_tpm     = null   // salmon.merged.gene_tpm.tsv from nf-core/rnaseq (genes × samples)
    pegasas_groups        = null   // TSV: sample_id<TAB>group. Auto-derived from samplesheet if not set.
    pegasas_num_interval  = 40     // parallel KS enrichment processes per batch
    pegasas_min_tpm       = 1.0    // only genes with TPM >= this form the KS background
    pegasas_fdr_cutoff    = 0.05   // pre-filter SE events: skip events with rMATS FDR >= this threshold (0 = disabled)
    pegasas_dpsi_cutoff   = 0.1    // pre-filter SE events: skip events with |IncLevelDifference| < this (0 = disabled)
    pegasas_perms         = 1000   // max permutations for pathway x PSI correlation test (200/1000/N tiered)

    // DE + AS integration — optional
    run_de_as  = false  // enable DE+AS integration section in reports
    // One or more DGE directories; each subdir is a DGE comparison holding a
    // *_DESeq2_results.csv. Set from params.yaml as a list, e.g.
    //   dge_dirs: [/path/to/results/dge, /path/to/results_SF3B1/dge]
    // A comma-separated string ("dir1,dir2") is also accepted.
    dge_dirs   = []
    // Deprecated: single-directory alias, still honoured (appended to dge_dirs).
    de_results = null
    // Explicit comparison_id -> DGE subdirectory-name overrides, for contrasts
    // the auto-derived reverse name cannot match. Set from params.yaml as
    //   de_results_map: {Some_Contrast: DGE_Subdir_Name}
    de_results_map = [:]

    // Deliverables publication layer (see reestructure_plan.md and assets/results_schema.yaml)
    publish_deliverables             = true    // build the run_info/ + contrasts/ layer
    publish_level                    = 'core_raw'  // 'core' | 'core_raw' | 'full' — see docs/output.md
    publish_raw                      = true    // false downgrades the native raw/ layer to core-like
    build_cross_tool_master          = true    // deliverable: cross_tool.master.tsv + cross_tool.gene_summary.tsv
    publish_rmats_jcec               = false   // publish rMATS *.MATS.JCEC.txt in raw/
    publish_rmats_individual_counts  = false   // publish rMATS individualCounts.* in raw/
    results_contract_version         = '2.4.0' // bumps when deliverables columns/semantics change

    // Single identifier per tool. Derived names (raw/<tool>/ dirs, table prefixes,
    // manifest keys) all come from here so there is one place to rename a tool.
    tool_ids = [
        rmats: 'rmats', majiq: 'majiq', isar: 'isar',
        leafcutter: 'leafcutter', sashimi: 'sashimi', pegasas: 'pegasas'
    ]

    // Default per-tool reliability notes. These are fallbacks: the effective
    // state per contrast (notably ISAR's engine/pinning) is computed in
    // build_results_manifest.py and surfaced per contrast.
    tool_reliability = [
        [ tool: 'rmats', status: 'ok',
          note: 'The fdr_floor_flag column documents rows whose FDR equals the --cstat numeric floor; that is column documentation, not a reliability caveat.' ],
        [ tool: 'majiq', status: 'ok',
          note: 'MAJIQ keeps its native default (|dPSI| >= 0.2, probability_changing >= 0.95), more conservative than the 0.1 rule used by the other tools.' ],
        [ tool: 'isar', status: 'ok',
          note: 'Evaluated per contrast: DEXSeq with non-pinned q-values is ok; satuRn or pinned q-values (IQR < 0.05 with |dIF| >= 0.1) are under_investigation.' ],
        [ tool: 'leafcutter', status: 'ok',
          note: 'An intron is significant when its cluster passes FDR and |deltapsi| >= 0.1; cluster_significant records the cluster-level call separately.' ],
        [ tool: 'sashimi', status: 'ok',
          note: 'PDFs are indexed by sashimi_index.tsv; novel splice-site events are included.' ],
        [ tool: 'pegasas', status: 'known_issue',
          note: 'Exploratory: the KS score is descriptive (no significance call), n_sig_events is BH-corrected and activity_diff is group2 - group1. With two groups, a PSI-activity correlation can reflect group separation alone.' ]
    ]

    // Boilerplate options
    help              = false
    publish_dir_mode  = 'copy'
    validate_params   = true
}

// Load base config
includeConfig 'conf/base.config'

// Load modules config
includeConfig 'conf/modules.config'

// Native Nextflow execution artefacts — collected under
// deliverables/run_info/pipeline_info/ so the audit evidence travels with the
// shippable layer.
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/deliverables/run_info/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/deliverables/run_info/pipeline_info/execution_trace.txt"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/deliverables/run_info/pipeline_info/execution_timeline.html"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/deliverables/run_info/pipeline_info/pipeline_dag.html"
}

// Profiles
profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        // Limit local executor to avoid OOM on workstations / shared nodes
        executor {
            name      = 'local'
            cpus      = 16
            memory    = '48 GB'
            queueSize = 4
        }
    }
    
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        executor {
            name      = 'local'
            cpus      = 16
            memory    = '48 GB'
            queueSize = 4
        }
    }
    
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        executor {
            name      = 'local'
            cpus      = 16
            memory    = '48 GB'
            queueSize = 4
        }
    }

    slurm {
        process.executor       = 'slurm'
        process.queue          = 'compute'
        process.clusterOptions = '--export=ALL'
        executor.queueSize     = 20
        executor.submitRateLimit = '10/1min'
    }

    test {
        includeConfig 'conf/test.config'
    }
    
    test_full {
        includeConfig 'conf/test_full.config'
    }

    // Force ISAR processes to run sequentially and cap resources for small
    // workstations. Use when the default uncapped parallelisation causes OOM
    // (satuRn is memory-bound — 32GB+ per concurrent ISAR_* task).
    // Activate with: -profile test,lowmem
    lowmem {
        process {
            withName: 'ISAR_IMPORT|ISAR_SWITCH_TEST|ISAR_EXTRACT_ORF|ISAR_SWITCH_CONSEQUENCES' {
                maxForks = 1
            }
        }
        executor {
            cpus      = 4
            memory    = '16 GB'
            queueSize = 2
        }
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']
